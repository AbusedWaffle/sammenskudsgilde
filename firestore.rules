rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
//  Sikkerhedsregler for Sammenskudsgilde
//
//  MODEL
//  • Alle brugere logges automatisk ind med Firebase ANONYM login (skal slås til i
//    Authentication). Det giver hver browser et stabilt uid, som reglerne kan bruge.
//  • Et gilde findes kun via sit lange tilfældige ID (24 tegn base62 ≈ 143 bit).
//    Man kan HENTE et gilde, hvis man kender ID'et, men man kan IKKE liste/søge i
//    samlingen "parties". Under-samlingerne kan kun listes via en kendt sti, og
//    collection-group-forespørgsler er ikke tilladt (ingen tilladende {path=**}-regler).
//  • Opretteren er den, hvis uid står i creatorUid. Opretteren får desuden en hemmelig
//    nøgle (gemt i localStorage + i et "admin-link"); kun SHA-256 af nøglen gemmes på
//    gildet (creatorHash). Nøglen kan bruges fra en anden enhed ved at oprette
//    claims/{uid} med { key } – reglerne tjekker hashen, og claims kan aldrig læses.
//  • Alle der har linket kan se alt og tilføje sig selv, retter og udgifter.
//    Kun opretteren kan rette/slette gildets detaljer og programpunkter.
//    Man kan rette/slette sine egne deltager-/ret-poster (opretteren kan også).
//  • Husstande: households/{id} med memberUids. Medlemmer af en husstand kan tilføje,
//    rette og fjerne husstandens personer UDEN egen bruger (børn, partner …) og sætte
//    deres status (kommer / kommer måske / kommer ikke). Ingen kan rette en anden
//    person MED bruger (undtagen værten).
//
//  ÆRLIGE BEGRÆNSNINGER (det er en vennegruppe-app, ikke en bank)
//  • Linket ER adgangen. Den, der får linket videresendt, kan se navne og
//    telefonnumre og tilføje/rette egne ting. Del det kun med gæsterne.
//  • Anonyme uid'er er bundet til browseren. Rydder man browserdata eller skifter
//    telefon, mister man retten til at rette sine gamle poster (opretteren kan stadig
//    via admin-linket). "Jeg er ikke X" i appen skifter kun mellem personer, der er
//    oprettet fra samme browser.
//  • Hvem-som-helst med linket kan oprette mange deltagere/poster (spam). Der er
//    størrelsesgrænser på felterne, men ingen hastighedsbegrænsning. Overvej App Check,
//    hvis det bliver et problem.
//  • Alle med linket kan melde sig ind i en husstand (ingen godkendelse) og derefter
//    rette dens personer uden bruger – og kan sige "Det er mig" til en person uden
//    bruger (også et barn). Det er et bevidst valg for en venne-app; værten kan rette alt tilbage.
//  • Reglerne kan ikke garantere, at beløb er "rigtige" – kun at de er heltal i øre
//    inden for et fornuftigt interval.
//  • Betalinger: kun et medlem af den betalende husstand (eller værten) kan markere "betalt",
//    og kun et medlem af den modtagende husstand (eller værten) kan bekræfte "modtaget".
//    Betalingspåmindelser (activity med targetPids) kan skrives af alle med linket; appen viser
//    kun knappen for modtageren og værten. Reglerne kan ikke hastighedsbegrænse påmindelser
//    (appen husker "sendt i dag" lokalt), og de når kun frem til skyldnere, der selv har slået
//    emnet "Betalinger" til. Da husstande er uden godkendelse, kan den, der melder sig ind i en
//    husstand, også markere/bekræfte dens betalinger – værten kan slette forkerte betalinger.
//  • Når et gilde slettes, sletter appen først under-dokumenterne. Efterladte
//    claims-dokumenter (fra andre enheder) er ulæselige og harmløse; andres
//    notifikations-abonnementer ryddes op af senderen (GitHub Actions).
//
//  v1.5
//  • payments/{id}: registrerede betalinger mellem husstande/enheder (fromUnit → toUnit, beløb i øre,
//    status 'marked' (markeret betalt) → 'confirmed' (modtaget)). Tæller som betalt i regnskabet.
//  • suggestions/{id}: forslag ("Det mangler vi"). "Jeg tager den" = opret en ret + sæt takenItemId i
//    samme batch; reglerne tjekker, at retten findes efter skrivningen og er ens egen.
//  • Deltagere kan have diet (liste) og dietNote; retter kan have tags (liste) og suggestionId.
//
//  NOTIFIKATIONER
//  • activity/{id}: en kort log ("Bo tager lasagne med"), som appen skriver ved hver
//    handling. Senderen (Admin SDK i GitHub Actions, som ikke er underlagt reglerne)
//    læser den og sender web push. Loggen kan ikke rettes; kun værten kan slette.
//  • subs/{uid}: notifikations-indstillinger + push-abonnement for ÉN enhed. Kun
//    ejeren (samme uid) kan læse/skrive sit eget dokument; ingen kan liste dem.
//    Felterne lastNotifiedAt, lastDigestAt, reminderSentFor og testSentAt skrives kun
//    af senderen. En e-mail-kanal kan senere tilføjes som channels.email.
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function partyDoc(pid) { return /databases/$(database)/documents/parties/$(pid); }
    function partyExists(pid) { return exists(partyDoc(pid)); }
    function isAdmin(pid) {
      return signedIn() && (
        get(partyDoc(pid)).data.creatorUid == request.auth.uid ||
        exists(/databases/$(database)/documents/parties/$(pid)/claims/$(request.auth.uid)));
    }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || isStr(d[k], 0, max); }
    // Felter der ikke må ændres ved opdatering
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // ── Gilder ────────────────────────────────────────────────────────────────
    function validParty(d) {
      return d.keys().hasOnly(['name', 'date', 'time', 'place', 'note', 'creatorUid', 'creatorHash', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'creatorUid', 'creatorHash'])
        && isStr(d.name, 1, 120)
        && optStr(d, 'date', 10) && optStr(d, 'time', 5)
        && optStr(d, 'place', 300) && optStr(d, 'note', 2000)
        && isStr(d.creatorHash, 64, 64);
    }
    match /parties/{pid} {
      allow get: if signedIn();
      allow list: if false;                                   // ingen søgning/listning af gilder
      allow create: if signedIn() && pid.size() >= 20
        && validParty(request.resource.data)
        && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isAdmin(pid) && validParty(request.resource.data)
        && unchanged(['creatorUid', 'creatorHash', 'createdAt']);
      allow delete: if isAdmin(pid);

      // ── Bevis for opretter-nøgle fra en anden enhed ─────────────────────────
      match /claims/{uid} {
        allow read: if false;                                 // nøglen kan aldrig læses tilbage
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['key', 'createdAt'])
          && request.resource.data.key is string
          && hashing.sha256(request.resource.data.key).toHexString().lower()
             == get(partyDoc(pid)).data.creatorHash.lower();
        allow delete: if signedIn() && uid == request.auth.uid;
      }

      // ── Programpunkter / retter (forret, hovedret, 14:00 kaffe …) ───────────
      function validEvent(d) {
        return d.keys().hasOnly(['title', 'time', 'kind', 'order', 'ownerUid', 'createdAt'])
          && isStr(d.title, 1, 80) && optStr(d, 'time', 5)
          && (!('kind' in d) || d.kind in ['ret', 'program'])
          && (!('order' in d) || d.order is number);
      }
      match /events/{eid} {
        allow read: if signedIn();
        allow create: if isAdmin(pid) && validEvent(request.resource.data);
        allow update: if isAdmin(pid) && validEvent(request.resource.data);
        allow delete: if isAdmin(pid);
      }

      // ── Husstande (Familien Wriedt …) ────────────────────────────────────────
      // memberUids = uid'er på de brugere (enheder), der er med i husstanden. Den, der er med,
      // kan rette navnet og husstandens medlemmer uden egen bruger. Alle kan melde SIG SELV ind
      // eller ud (ingen godkendelse – det er en venne-app), men ingen kan fjerne andre brugere.
      function validHousehold(d) {
        return d.keys().hasOnly(['name', 'memberUids', 'createdByUid', 'createdAt'])
          && d.keys().hasAll(['name', 'memberUids', 'createdByUid'])
          && isStr(d.name, 1, 60) && d.memberUids is list && d.memberUids.size() <= 50
          && d.createdByUid is string;
      }
      function onlySelfChanged() {
        let n = request.resource.data.memberUids.toSet();
        let o = resource.data.memberUids.toSet();
        return n.difference(o).hasOnly([request.auth.uid]) && o.difference(n).hasOnly([request.auth.uid]);
      }
      match /households/{hid} {
        allow read: if signedIn();
        allow create: if signedIn() && partyExists(pid) && hid.size() >= 10
          && validHousehold(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.memberUids == [request.auth.uid];
        allow update: if signedIn() && validHousehold(request.resource.data)
          && unchanged(['createdByUid', 'createdAt'])
          && (isAdmin(pid)
              || (onlySelfChanged()
                  && (resource.data.memberUids.hasAny([request.auth.uid])            // medlem: omdøb / meld dig ud
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']))));  // meld dig ind
        allow delete: if signedIn() && (isAdmin(pid)
          || (resource.data.memberUids.hasAny([request.auth.uid]) && resource.data.memberUids.hasOnly([request.auth.uid])));
      }

      // ── Deltagere ────────────────────────────────────────────────────────────
      // ownerUid = brugeren (enheden) der ejer deltageren. ownerUid == '' betyder "uden egen bruger"
      // (fx et barn eller en partner, som et husstandsmedlem har tilføjet; addedByUid = hvem).
      // Den, der åbner linket, kan overtage en person uden bruger ("Det er mig") – samme ID, så
      // retter og udgifter følger med. Alle felter ud over name/phone/ownerUid er valgfri, så
      // deltagere oprettet af den tidligere version af appen stadig er gyldige.
      function validParticipant(d) {
        return d.keys().hasOnly(['name', 'phone', 'ownerUid', 'createdAt', 'householdId', 'isChild', 'status', 'addedByUid',
                                 'diet', 'dietNote'])
          && isStr(d.name, 1, 60) && isStr(d.phone, 0, 20) && d.ownerUid is string
          && optStr(d, 'householdId', 40)
          && (!('isChild' in d) || d.isChild is bool)
          && (!('status' in d) || d.status in ['yes', 'maybe', 'no'])
          && optStr(d, 'addedByUid', 128)
          && (!('diet' in d) || (d.diet is list && d.diet.size() <= 10))            // kost/allergier (vegetar, noedder …)
          && optStr(d, 'dietNote', 120);
      }
      function hhDoc(pid, hid) { return /databases/$(database)/documents/parties/$(pid)/households/$(hid); }
      function hhOf(d) { return d.get('householdId', ''); }
      // Er jeg medlem af husstanden (før / efter denne skrivning – "efter" tillader batch: meld ind + sæt householdId)
      function inHousehold(pid, hid) {
        return hid != '' && exists(hhDoc(pid, hid)) && get(hhDoc(pid, hid)).data.memberUids.hasAny([request.auth.uid]);
      }
      function inHouseholdAfter(pid, hid) {
        return hid != '' && existsAfter(hhDoc(pid, hid)) && getAfter(hhDoc(pid, hid)).data.memberUids.hasAny([request.auth.uid]);
      }
      function householdChangeOk(pid) {
        let n = hhOf(request.resource.data);
        return n == hhOf(resource.data) || n == '' || inHouseholdAfter(pid, n);
      }
      match /participants/{ppid} {
        allow read: if signedIn();
        allow create: if signedIn() && partyExists(pid)
          && validParticipant(request.resource.data)
          && (
            // mig selv
            (request.resource.data.ownerUid == request.auth.uid
              && request.resource.data.get('addedByUid', request.auth.uid) == request.auth.uid
              && (hhOf(request.resource.data) == '' || inHouseholdAfter(pid, hhOf(request.resource.data))))
            // en person uden bruger, tilføjet af et medlem af husstanden (eller værten)
            || (request.resource.data.ownerUid == ''
              && request.resource.data.get('addedByUid', '') == request.auth.uid
              && (inHouseholdAfter(pid, hhOf(request.resource.data)) || isAdmin(pid)))
          );
        allow update: if signedIn() && validParticipant(request.resource.data)
          && unchanged(['createdAt', 'addedByUid'])
          && (
            // værten kan rette alt (men ikke flytte ejerskab)
            (isAdmin(pid) && unchanged(['ownerUid']))
            // ejeren retter sig selv
            || (resource.data.ownerUid == request.auth.uid && unchanged(['ownerUid']) && householdChangeOk(pid))
            // et medlem af husstanden retter en person uden bruger (navn, tlf., barn, status …)
            || (resource.data.ownerUid == '' && request.resource.data.ownerUid == ''
              && inHousehold(pid, hhOf(resource.data)) && householdChangeOk(pid))
            // "Det er mig": overtag en person uden bruger – voksen eller barn – (samme ID). Man bliver samtidig
            // medlem af husstanden og må rette navn, telefon, status og om man er barn.
            || (resource.data.ownerUid == '' && request.resource.data.ownerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'name', 'phone', 'status', 'isChild'])
              && (hhOf(resource.data) == '' || inHouseholdAfter(pid, hhOf(resource.data))))
          );
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin(pid)
          || (resource.data.ownerUid == '' && inHousehold(pid, hhOf(resource.data))));
      }

      // ── Aktivitetslog (til notifikationer) ─────────────────────────────────
      match /activity/{aid} {
        allow read: if signedIn();
        allow create: if signedIn() && partyExists(pid)
          && request.resource.data.keys().hasOnly(['type', 'text', 'actorUid', 'participantId', 'hasCost', 'targetPids', 'createdAt'])
          && request.resource.data.type in ['guest', 'item', 'cost', 'party', 'payment']
          && (!('targetPids' in request.resource.data)                                  // målrettet (fx betalingspåmindelse)
              || (request.resource.data.targetPids is list && request.resource.data.targetPids.size() <= 50))
          && (request.resource.data.type != 'party' || isAdmin(pid))
          && isStr(request.resource.data.text, 1, 200)
          && request.resource.data.actorUid == request.auth.uid
          && isStr(request.resource.data.participantId, 0, 40)
          && (!('hasCost' in request.resource.data) || request.resource.data.hasCost is bool)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin(pid);
      }

      // ── Notifikations-abonnementer (ét pr. enhed/uid) ────────────────────────
      function senderFields() { return ['lastNotifiedAt', 'lastDigestAt', 'reminderSentFor', 'testSentAt']; }
      function validSub(d) {
        return d.keys().hasOnly(['enabled', 'participantId', 'channels', 'topics', 'frequency', 'digestHour',
                                 'reminderBefore', 'tz', 'baselineAt', 'testRequestedAt', 'createdAt', 'updatedAt',
                                 'lastNotifiedAt', 'lastDigestAt', 'reminderSentFor', 'testSentAt'])
          && d.enabled is bool
          && isStr(d.participantId, 0, 40)
          && d.channels is map && d.channels.keys().hasOnly(['push'])            // senere: 'email'
          && (!('push' in d.channels) || (
                d.channels.push is map && d.channels.push.keys().hasOnly(['endpoint', 'keys', 'ua'])
                && isStr(d.channels.push.endpoint, 10, 1000) && d.channels.push.endpoint.matches('https://.*')
                && d.channels.push.keys is map && d.channels.push.keys.keys().hasOnly(['p256dh', 'auth'])
                && isStr(d.channels.push.keys.p256dh, 1, 200) && isStr(d.channels.push.keys.auth, 1, 100)
                && (!('ua' in d.channels.push) || isStr(d.channels.push.ua, 0, 40))))
          && d.topics is map && d.topics.keys().hasOnly(['guests', 'items', 'party', 'costs', 'payments', 'reminder'])
          && d.frequency in ['instant', 'daily', 'reminderOnly']
          && d.digestHour is int && d.digestHour >= 0 && d.digestHour <= 23
          && d.reminderBefore in ['1d', '3h']
          && isStr(d.tz, 1, 50);
      }
      match /subs/{uid} {
        allow get: if signedIn() && uid == request.auth.uid;
        allow list: if false;
        allow create: if signedIn() && uid == request.auth.uid && partyExists(pid)
          && validSub(request.resource.data)
          && !request.resource.data.keys().hasAny(senderFields());
        allow update: if signedIn() && uid == request.auth.uid
          && validSub(request.resource.data)
          && unchanged(senderFields().concat(['createdAt']))
          && (!('testRequestedAt' in request.resource.data)
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['testRequestedAt'])
              || request.resource.data.testRequestedAt == request.time);
        allow delete: if signedIn() && uid == request.auth.uid;
      }

      // ── Retter, aktiviteter og udgifter ──────────────────────────────────────
      function validItem(d) {
        return d.keys().hasOnly(['eventId', 'participantId', 'ownerUid', 'title', 'kind', 'servings',
                                 'note', 'cost', 'split', 'among', 'tags', 'suggestionId', 'createdAt'])
          && isStr(d.title, 1, 100) && d.eventId is string && d.participantId is string
          && d.ownerUid is string
          && (!('kind' in d) || d.kind in ['ret', 'aktivitet', 'andet', 'udgift'])
          && (!('servings' in d) || (d.servings is int && d.servings >= 0 && d.servings <= 1000))
          && optStr(d, 'note', 500)
          && (!('cost' in d) || (d.cost is int && d.cost >= 0 && d.cost <= 100000000))   // øre, max 1 mio. kr.
          && (!('split' in d) || d.split in ['all', 'selected', 'households', 'none'])   // 'none' = deles ikke (betaler selv)
          && (!('among' in d) || (d.among is list && d.among.size() <= 200))
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 10))              // noedder, gluten, vegetar …
          && optStr(d, 'suggestionId', 40);
      }
      match /items/{iid} {
        allow read: if signedIn();
        allow create: if signedIn() && partyExists(pid)
          && validItem(request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin(pid))
          && validItem(request.resource.data) && unchanged(['ownerUid', 'createdAt']);
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin(pid));
      }

      // ── Forslag: "Det mangler vi" ────────────────────────────────────────────
      // Alle kan foreslå. "Jeg tager den": opret en ret (med suggestionId) og sæt takenItemId på forslaget i
      // SAMME batch – retten skal findes efter skrivningen og være ens egen. Den, der tog forslaget (eller
      // værten), kan fortryde. Et forslag, hvis ret er slettet, er ledigt igen. Opretteren/værten kan slette.
      function itemDoc(pid, iid) { return /databases/$(database)/documents/parties/$(pid)/items/$(iid); }
      function takenFields() { return ['takenByUid', 'takenByPid', 'takenItemId', 'takenAt']; }
      function validSuggestion(d) {
        return d.keys().hasOnly(['title', 'eventId', 'note', 'ownerUid', 'byPid', 'createdAt',
                                 'takenByUid', 'takenByPid', 'takenItemId', 'takenAt'])
          && isStr(d.title, 1, 100) && isStr(d.eventId, 0, 40) && optStr(d, 'note', 200)
          && d.ownerUid is string && optStr(d, 'byPid', 40)
          && optStr(d, 'takenByUid', 128) && optStr(d, 'takenByPid', 40) && optStr(d, 'takenItemId', 40);
      }
      function sugFree(d) {
        return d.get('takenItemId', '') == '' || !exists(itemDoc(pid, d.get('takenItemId', '')));
      }
      match /suggestions/{sid} {
        allow read: if signedIn();
        allow create: if signedIn() && partyExists(pid)
          && validSuggestion(request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !request.resource.data.keys().hasAny(takenFields());
        allow update: if signedIn() && validSuggestion(request.resource.data) && unchanged(['ownerUid', 'createdAt', 'byPid'])
          && (
            // opretteren/værten retter tekst og ret
            ((resource.data.ownerUid == request.auth.uid || isAdmin(pid))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'eventId', 'note']))
            // "Jeg tager den" (i samme batch som retten)
            || (sugFree(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(takenFields())
              && request.resource.data.takenByUid == request.auth.uid
              && request.resource.data.takenAt == request.time
              && isStr(request.resource.data.takenItemId, 1, 40)
              && existsAfter(itemDoc(pid, request.resource.data.takenItemId))
              && getAfter(itemDoc(pid, request.resource.data.takenItemId)).data.ownerUid == request.auth.uid)
            // "Fortryd": den, der tog den, eller værten sætter den tilbage som forslag
            || ((resource.data.get('takenByUid', '') == request.auth.uid || isAdmin(pid))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(takenFields())
              && request.resource.data.get('takenItemId', '') == '' && request.resource.data.get('takenByUid', '') == '')
          );
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin(pid));
      }

      // ── Betalinger mellem husstande ("Jeg har betalt" / "Modtaget") ───────────
      // fromUnit/toUnit = husstands-id eller (for enlige) deltager-id. fromPid/toPid = personerne, så
      // betalingen kan følge dem, hvis husstande ændres. Status 'marked' → 'confirmed'.
      function pDoc(pid, ppid) { return /databases/$(database)/documents/parties/$(pid)/participants/$(ppid); }
      // Er jeg med i enheden? (medlem af husstanden, eller ejer af deltageren)
      function unitMember(pid, u) {
        return (exists(hhDoc(pid, u)) && get(hhDoc(pid, u)).data.memberUids.hasAny([request.auth.uid]))
          || (exists(pDoc(pid, u)) && get(pDoc(pid, u)).data.ownerUid == request.auth.uid);
      }
      function validPayment(d) {
        return d.keys().hasOnly(['fromUnit', 'toUnit', 'fromPid', 'toPid', 'amount', 'status', 'ownerUid', 'createdAt',
                                 'confirmedByUid', 'confirmedAt'])
          && d.keys().hasAll(['fromUnit', 'toUnit', 'amount', 'status', 'ownerUid'])
          && isStr(d.fromUnit, 1, 40) && isStr(d.toUnit, 1, 40) && d.fromUnit != d.toUnit
          && optStr(d, 'fromPid', 40) && optStr(d, 'toPid', 40)
          && d.amount is int && d.amount > 0 && d.amount <= 100000000
          && d.status in ['marked', 'confirmed']
          && d.ownerUid is string;
      }
      match /payments/{payid} {
        allow read: if signedIn();
        allow create: if signedIn() && partyExists(pid)
          && validPayment(request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            // "Jeg har betalt" – fra min husstand (eller værten registrerer)
            (request.resource.data.status == 'marked' && !('confirmedByUid' in request.resource.data)
              && !('confirmedAt' in request.resource.data)
              && (unitMember(pid, request.resource.data.fromUnit) || isAdmin(pid)))
            // "Modtaget" direkte (fx kontant) – af modtageren (eller værten)
            || (request.resource.data.status == 'confirmed' && request.resource.data.confirmedByUid == request.auth.uid
              && request.resource.data.confirmedAt == request.time
              && (unitMember(pid, request.resource.data.toUnit) || isAdmin(pid)))
          );
        // Bekræft en markering: kun status/confirmedByUid/confirmedAt ændres, af modtageren (eller værten)
        allow update: if signedIn() && validPayment(request.resource.data)
          && resource.data.status == 'marked' && request.resource.data.status == 'confirmed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedByUid', 'confirmedAt'])
          && request.resource.data.confirmedByUid == request.auth.uid
          && request.resource.data.confirmedAt == request.time
          && (unitMember(pid, resource.data.toUnit) || isAdmin(pid));
        // Fortryd (den der markerede) / "Ikke modtaget" (modtageren) / fortryd bekræftelse (den der bekræftede) / værten
        allow delete: if signedIn() && (isAdmin(pid)
          || (resource.data.status == 'marked' && (resource.data.ownerUid == request.auth.uid || unitMember(pid, resource.data.toUnit)))
          || (resource.data.status == 'confirmed' && resource.data.get('confirmedByUid', '') == request.auth.uid));
      }
    }

    // Alt andet er lukket.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
